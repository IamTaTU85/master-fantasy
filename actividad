<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0c0f16">
<link rel="manifest" href="manifest.webmanifest">
<link rel="apple-touch-icon" href="icon-192.svg">
<title>MASTER FANTASY</title>
<style>
:root{
  --bg:#0b0e15;--panel:#141925;--panel2:#1b2231;--line:#2c3547;
  --text:#f7f9fc;--muted:#9fa9bb;--red:#ff4b43;--green:#32d583;
  --yellow:#f5c84c;--blue:#58a6ff;--shadow:0 16px 40px rgba(0,0,0,.28)
}
*{box-sizing:border-box}
html,body{margin:0;background:linear-gradient(180deg,#090c12,#111724);color:var(--text);
font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
body{min-height:100vh}
header{position:sticky;top:0;z-index:50;background:rgba(9,12,18,.93);backdrop-filter:blur(14px);
border-bottom:2px solid var(--red);padding:calc(12px + env(safe-area-inset-top)) 16px 12px}
.wrap{max-width:1500px;margin:auto}
.topbar{display:flex;align-items:center;justify-content:space-between;gap:12px}
.brand{font-weight:900;font-size:20px;letter-spacing:.5px}
.brand b{color:var(--red)}
.status{font-size:12px;color:var(--muted)}
main{padding:16px 16px calc(92px + env(safe-area-inset-bottom))}
.tabs{display:flex;gap:8px;overflow:auto;padding-bottom:4px;margin-bottom:14px}
.tabs button{white-space:nowrap}
button,.btn{border:1px solid var(--line);background:var(--panel);color:var(--text);padding:11px 14px;
border-radius:12px;font-weight:800;cursor:pointer}
button.active,.primary{background:var(--red);border-color:var(--red)}
button:hover{filter:brightness(1.08)}
.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:14px}
.card{background:linear-gradient(180deg,var(--panel),#111723);border:1px solid var(--line);
border-radius:18px;padding:16px;box-shadow:var(--shadow)}
.kpi{grid-column:span 3}
.kpi .n{font-size:28px;font-weight:900;margin-top:8px}
.two{grid-column:span 6}.full{grid-column:1/-1}
h2,h3{margin:0 0 12px}.muted{color:var(--muted)}.tiny{font-size:12px}
table{width:100%;border-collapse:collapse;font-size:14px}
th,td{padding:10px 8px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
th{font-size:11px;text-transform:uppercase;letter-spacing:.6px;color:#cdd5e3}
.scroll{overflow:auto}
.badge{display:inline-block;padding:4px 8px;border-radius:999px;font-size:11px;font-weight:900}
.buy{background:rgba(88,166,255,.16);color:#8bc3ff}
.sell{background:rgba(50,213,131,.16);color:#69e7aa}
.clause{background:rgba(255,75,67,.17);color:#ff8d87}
.good{color:var(--green)}.warn{color:var(--yellow)}.bad{color:#ff7770}
.rank{color:var(--red);font-weight:900}
.section{display:none}.section.active{display:block}
.form{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}
label{display:block;color:var(--muted);font-size:12px;margin-bottom:5px}
input,select,textarea{width:100%;padding:11px;border-radius:10px;border:1px solid var(--line);
background:#0c111a;color:var(--text)}
textarea{min-height:90px;resize:vertical}
.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.note{background:#0f1520;border-left:4px solid var(--red);padding:12px;border-radius:10px}
.mobile-nav{display:none;position:fixed;left:0;right:0;bottom:0;z-index:60;background:rgba(10,13,20,.96);
backdrop-filter:blur(14px);border-top:1px solid var(--line);padding:8px 10px calc(8px + env(safe-area-inset-bottom));
grid-template-columns:repeat(5,1fr);gap:6px}
.mobile-nav button{padding:9px 5px;font-size:11px;border-radius:10px}
.hero{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}
.hero strong{font-size:20px}
.metric{display:flex;justify-content:space-between;gap:12px;padding:9px 0;border-bottom:1px dashed var(--line)}
.progress{height:8px;background:#0a0f17;border-radius:99px;overflow:hidden}
.progress span{display:block;height:100%;background:var(--red)}
@media(max-width:1000px){
  .kpi{grid-column:span 6}.two{grid-column:1/-1}.form{grid-template-columns:1fr 1fr 1fr}
}
@media(max-width:720px){
  header{padding-left:12px;padding-right:12px}.brand{font-size:17px}.status{display:none}
  main{padding:12px 12px calc(92px + env(safe-area-inset-bottom))}
  .tabs{display:none}.mobile-nav{display:grid}
  .kpi,.two,.full{grid-column:1/-1}.form{grid-template-columns:1fr 1fr}
  .card{border-radius:15px;padding:14px}.kpi .n{font-size:24px}
  th,td{font-size:12px;padding:9px 7px}
}
</style>
</head>
<body>
<header>
  <div class="wrap topbar">
    <div>
      <div class="brand">MASTER <b>FANTASY</b></div>
      <div class="status">Centro de mando · LALIGAMETODOS LEAGUE</div>
    </div>
    <button onclick="installApp()" id="installBtn">Instalar</button>
  </div>
</header>

<main class="wrap">
  <div class="tabs" id="desktopTabs">
    <button class="active" data-tab="dashboard">Dashboard</button>
    <button data-tab="movimientos">Movimientos</button>
    <button data-tab="managers">Managers</button>
    <button data-tab="registro">Registrar</button>
    <button data-tab="datos">Copias</button>
  </div>

  <section id="dashboard" class="section active">
    <div class="grid">
      <div class="card kpi"><div class="muted">Managers</div><div class="n" id="kManagers">0</div></div>
      <div class="card kpi"><div class="muted">Operaciones</div><div class="n" id="kOps">0</div></div>
      <div class="card kpi"><div class="muted">Recompensa acumulada</div><div class="n" id="kReward">0 €</div></div>
      <div class="card kpi"><div class="muted">Saldo Ramon.CR85</div><div class="n" id="kRamon">0 €</div></div>

      <div class="card two">
        <h3>💰 Ranking de saldo</h3>
        <div class="scroll"><table><thead><tr><th>#</th><th>Manager</th><th>Saldo</th><th>Cap. puja</th></tr></thead><tbody id="rankSaldo"></tbody></table></div>
      </div>

      <div class="card two">
        <h3>📈 Ranking de plantilla</h3>
        <div class="scroll"><table><thead><tr><th>#</th><th>Manager</th><th>Valor</th><th>20%</th></tr></thead><tbody id="rankValor"></tbody></table></div>
      </div>

      <div class="card full">
        <div class="hero">
          <div><strong>Lectura competitiva</strong><div class="muted tiny">Actualizada con todos los movimientos registrados</div></div>
        </div>
        <div id="insights" style="margin-top:12px"></div>
      </div>
    </div>
  </section>

  <section id="movimientos" class="section">
    <div class="card">
      <h2>Historial de movimientos</h2>
      <div class="scroll"><table>
        <thead><tr><th>Fecha</th><th>Hora</th><th>Tipo</th><th>Manager</th><th>Jugador</th><th>Origen</th><th>Importe</th></tr></thead>
        <tbody id="movTable"></tbody>
      </table></div>
    </div>
  </section>

  <section id="managers" class="section">
    <div class="card">
      <h2>Estado económico</h2>
      <div class="scroll"><table>
        <thead><tr><th>Manager</th><th>Saldo</th><th>Plantilla</th><th>Deuda 20%</th><th>Capacidad puja</th><th>Notas</th></tr></thead>
        <tbody id="managerTable"></tbody>
      </table></div>
    </div>
  </section>

  <section id="registro" class="section">
    <div class="card">
      <h2>Registrar operación</h2>
      <div class="form">
        <div><label>Fecha</label><input id="fFecha" type="date"></div>
        <div><label>Hora</label><input id="fHora" type="time"></div>
        <div><label>Tipo</label><select id="fTipo"><option>Compra</option><option>Venta</option><option>Clausulazo</option></select></div>
        <div><label>Manager</label><select id="fManager"></select></div>
        <div><label>Jugador</label><input id="fJugador"></div>
        <div><label>Importe (€)</label><input id="fImporte" type="number" min="0"></div>
      </div>
      <div class="form" style="margin-top:10px">
        <div><label>Origen</label><input id="fOrigen" placeholder="LALIGA o rival"></div>
        <div style="grid-column:span 5"><label>Notas</label><input id="fNotas"></div>
      </div>
      <div class="actions"><button class="primary" onclick="addMovement()">Guardar</button></div>
    </div>

    <div class="card" style="margin-top:14px">
      <h2>Actualizar manager</h2>
      <div class="form">
        <div><label>Manager</label><select id="uManager"></select></div>
        <div><label>Valor plantilla</label><input id="uValor" type="number"></div>
        <div><label>Ajuste de saldo</label><input id="uAjuste" type="number" placeholder="Premio/ajuste"></div>
        <div style="grid-column:span 3"><label>Notas</label><input id="uNotas"></div>
      </div>
      <div class="actions"><button onclick="updateManager()">Actualizar</button></div>
    </div>
  </section>

  <section id="datos" class="section">
    <div class="grid">
      <div class="card two">
        <h2>Exportar copia</h2>
        <p class="muted">Guarda toda la base de datos en un archivo JSON.</p>
        <button onclick="exportJSON()">Descargar JSON</button>
      </div>
      <div class="card two">
        <h2>Importar copia</h2>
        <input id="importFile" type="file" accept=".json">
        <div class="actions"><button onclick="importJSON()">Importar</button></div>
      </div>
      <div class="card full">
        <h2>Información</h2>
        <div class="note">La recompensa diaria se calcula automáticamente desde el 28/07/2026 a razón de 100.000 € por día y manager. Para los rivales presupone que todos la reclaman; cualquier excepción puede corregirse con un ajuste manual.</div>
      </div>
    </div>
  </section>
</main>

<nav class="mobile-nav" id="mobileTabs">
  <button class="active" data-tab="dashboard">Inicio</button>
  <button data-tab="movimientos">Actividad</button>
  <button data-tab="managers">Rivales</button>
  <button data-tab="registro">Añadir</button>
  <button data-tab="datos">Copias</button>
</nav>

<script>
const START_DATE="2026-07-28", DAILY_REWARD=100000;
const INITIAL={
 managers:[
  {name:"Ramon.CR85",base:102115951,value:131330381,adjust:0,notes:"Nuestro equipo"},
  {name:"Watered",base:100000000,value:130000000,adjust:0,notes:"Jose Antonio · agresivo"},
  {name:"Hello Moto",base:100000000,value:130000000,adjust:0,notes:""},
  {name:"J Cabrejo",base:100000000,value:130000000,adjust:0,notes:""},
  {name:"Atotxa2022",base:100000000,value:130000000,adjust:0,notes:"Iban · actividad alta"},
  {name:"Jonpetito",base:100000000,value:130200000,adjust:0,notes:"Jon · doble campeón"},
  {name:"kikeman1",base:100000000,value:124900000,adjust:0,notes:""},
  {name:"kvalentinov",base:100000000,value:123800000,adjust:0,notes:"Kalo · campeón vigente"},
  {name:"ClipperX55",base:100000000,value:130000000,adjust:0,notes:""}
 ],
 movements:[
  {date:"2026-07-29",time:"",type:"Venta",manager:"kikeman1",player:"M. Román",origin:"LALIGA",amount:6120139},
  {date:"2026-07-29",time:"",type:"Venta",manager:"kikeman1",player:"Manuel Fernández",origin:"LALIGA",amount:490637},
  {date:"2026-07-29",time:"",type:"Venta",manager:"Jonpetito",player:"Cardona",origin:"LALIGA",amount:5641082},
  {date:"2026-07-29",time:"",type:"Venta",manager:"Jonpetito",player:"Rodrygo",origin:"LALIGA",amount:4310947},
  {date:"2026-07-29",time:"",type:"Venta",manager:"kvalentinov",player:"Puado",origin:"LALIGA",amount:10952586},
  {date:"2026-07-29",time:"",type:"Compra",manager:"Atotxa2022",player:"Moncayola",origin:"LALIGA",amount:6266666},
  {date:"2026-07-29",time:"",type:"Compra",manager:"kvalentinov",player:"Quagliata",origin:"LALIGA",amount:4500000},
  {date:"2026-07-29",time:"",type:"Compra",manager:"Atotxa2022",player:"Ionut Radu",origin:"LALIGA",amount:38838551},
  {date:"2026-07-29",time:"21:42",type:"Venta",manager:"Watered",player:"Gattoni",origin:"LALIGA",amount:525096},
  {date:"2026-07-30",time:"07:46",type:"Venta",manager:"Atotxa2022",player:"J. M. Giménez",origin:"LALIGA",amount:7405344},
  {date:"2026-07-30",time:"07:47",type:"Venta",manager:"Atotxa2022",player:"Iago Aspas",origin:"LALIGA",amount:10155745},
  {date:"2026-07-30",time:"14:11",type:"Venta",manager:"kvalentinov",player:"V. Rosier",origin:"LALIGA",amount:9495383},
  {date:"2026-07-30",time:"14:11",type:"Venta",manager:"kvalentinov",player:"Sadiq",origin:"LALIGA",amount:9982480},
  {date:"2026-07-30",time:"14:26",type:"Compra",manager:"Ramon.CR85",player:"A. Abqar",origin:"LALIGA",amount:6000001},
  {date:"2026-07-30",time:"14:26",type:"Compra",manager:"Atotxa2022",player:"Alemão",origin:"LALIGA",amount:4683889},
  {date:"2026-07-30",time:"14:26",type:"Compra",manager:"Atotxa2022",player:"Camello",origin:"LALIGA",amount:3396847},
  {date:"2026-07-30",time:"14:26",type:"Compra",manager:"kvalentinov",player:"Lo Celso",origin:"LALIGA",amount:42050000},
  {date:"2026-07-30",time:"14:26",type:"Compra",manager:"Watered",player:"Pau Cubarsí",origin:"LALIGA",amount:100362788},
  {date:"2026-07-30",time:"15:11",type:"Venta",manager:"kikeman1",player:"Gorrotxa",origin:"LALIGA",amount:9924015}
 ]};
let data=JSON.parse(localStorage.getItem("masterFantasyPWA")||"null")||structuredClone(INITIAL);
let deferredPrompt=null;
window.addEventListener("beforeinstallprompt",e=>{e.preventDefault();deferredPrompt=e;document.getElementById("installBtn").style.display="block"});
function installApp(){ if(deferredPrompt){deferredPrompt.prompt();deferredPrompt=null}else{alert("En iPhone: Compartir → Añadir a pantalla de inicio. En Windows/Chrome: menú de Chrome → Instalar aplicación.")}}
function daysReward(){
 const start=new Date(START_DATE+"T00:00:00"), now=new Date();
 const days=Math.floor((new Date(now.getFullYear(),now.getMonth(),now.getDate())-start)/86400000)+1;
 return Math.max(0,days)*DAILY_REWARD;
}
function money(n){return new Intl.NumberFormat("es-ES",{style:"currency",currency:"EUR",maximumFractionDigits:0}).format(n||0)}
function balance(m){
 let b=m.base+(m.adjust||0)+daysReward();
 for(const x of data.movements.filter(x=>x.manager===m.name)) b+=x.type==="Venta"?x.amount:-x.amount;
 return b;
}
function save(){localStorage.setItem("masterFantasyPWA",JSON.stringify(data));render()}
function render(){
 const reward=daysReward();
 const ms=data.managers.map(m=>({...m,balance:balance(m),debt:(m.value||0)*.2,capacity:balance(m)+(m.value||0)*.2}));
 kManagers.textContent=ms.length;kOps.textContent=data.movements.length;kReward.textContent=money(reward);
 kRamon.textContent=money(ms.find(x=>x.name==="Ramon.CR85").balance);
 rankSaldo.innerHTML=[...ms].sort((a,b)=>b.balance-a.balance).map((m,i)=>`<tr><td class="rank">${i+1}</td><td>${m.name}</td><td>${money(m.balance)}</td><td>${money(m.capacity)}</td></tr>`).join("");
 rankValor.innerHTML=[...ms].sort((a,b)=>b.value-a.value).map((m,i)=>`<tr><td class="rank">${i+1}</td><td>${m.name}</td><td>${money(m.value)}</td><td>${money(m.debt)}</td></tr>`).join("");
 const top=[...ms].sort((a,b)=>b.capacity-a.capacity)[0], low=[...ms].sort((a,b)=>a.balance-b.balance)[0];
 insights.innerHTML=`<div class="metric"><span>Mayor capacidad teórica</span><b>${top.name} · ${money(top.capacity)}</b></div>
 <div class="metric"><span>Menor saldo estimado</span><b>${low.name} · ${money(low.balance)}</b></div>
 <div class="metric"><span>Recompensa acumulada por manager</span><b>${money(reward)}</b></div>`;
 movTable.innerHTML=[...data.movements].sort((a,b)=>(b.date+b.time).localeCompare(a.date+a.time)).map(x=>`<tr><td>${x.date}</td><td>${x.time||"—"}</td><td><span class="badge ${x.type==="Venta"?"sell":x.type==="Clausulazo"?"clause":"buy"}">${x.type}</span></td><td>${x.manager}</td><td>${x.player}</td><td>${x.origin||"—"}</td><td>${money(x.amount)}</td></tr>`).join("");
 managerTable.innerHTML=[...ms].sort((a,b)=>b.capacity-a.capacity).map(m=>`<tr><td><b>${m.name}</b></td><td>${money(m.balance)}</td><td>${money(m.value)}</td><td>${money(m.debt)}</td><td><b>${money(m.capacity)}</b></td><td>${m.notes||""}</td></tr>`).join("");
 const opts=data.managers.map(m=>`<option>${m.name}</option>`).join("");fManager.innerHTML=opts;uManager.innerHTML=opts;
}
function addMovement(){
 const amount=Number(fImporte.value),player=fJugador.value.trim();if(!amount||!player){alert("Falta jugador o importe.");return}
 data.movements.push({date:fFecha.value||new Date().toISOString().slice(0,10),time:fHora.value,type:fTipo.value,manager:fManager.value,player,origin:fOrigen.value.trim(),amount,notes:fNotas.value.trim()});save();alert("Operación guardada.");
}
function updateManager(){
 const m=data.managers.find(x=>x.name===uManager.value);if(uValor.value!=="")m.value=Number(uValor.value);if(uAjuste.value!=="")m.adjust=(m.adjust||0)+Number(uAjuste.value);if(uNotas.value.trim())m.notes=uNotas.value.trim();save();alert("Manager actualizado.");
}
function exportJSON(){const blob=new Blob([JSON.stringify(data,null,2)],{type:"application/json"});const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="master-fantasy-backup.json";a.click()}
function importJSON(){const f=importFile.files[0];if(!f)return alert("Selecciona un JSON.");const r=new FileReader();r.onload=()=>{try{data=JSON.parse(r.result);save();alert("Copia importada.")}catch{alert("JSON no válido.")}};r.readAsText(f)}
function switchTab(id){
 document.querySelectorAll(".section").forEach(x=>x.classList.toggle("active",x.id===id));
 document.querySelectorAll("[data-tab]").forEach(x=>x.classList.toggle("active",x.dataset.tab===id));
 window.scrollTo({top:0,behavior:"smooth"});
}
document.querySelectorAll("[data-tab]").forEach(b=>b.onclick=()=>switchTab(b.dataset.tab));
fFecha.value=new Date().toISOString().slice(0,10);
if("serviceWorker" in navigator) navigator.serviceWorker.register("sw.js");
render();
</script>
</body>
</html>
